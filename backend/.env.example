# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Wise (international transfers)
WISE_API_KEY=your-wise-api-key
WISE_PROFILE_ID=your-wise-profile-id

# LINE Messaging
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Resend (email)
RESEND_API_KEY=re_xxxxx

# ECPay (payment gateway)
ECPAY_MERCHANT_ID=your-merchant-id
ECPAY_HASH_KEY=your-hash-key
ECPAY_HASH_IV=your-hash-iv

# Exchange rate
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/EUR
EXCHANGE_RATE_CACHE_TTL=3600

# Scraper config
SCRAPER_RATE_LIMIT=20
SCRAPER_MIN_DELAY=3.0
SCRAPER_MAX_DELAY=6.0
SCRAPER_FULL_SCHEDULE_CRON=0 2 * * *
SCRAPER_DELTA_SCHEDULE_CRON=0 */4 * * *
SCRAPER_AVAILABILITY_SCHEDULE_CRON=0 */1 * * *

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
